<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LPU Banking - Admin Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="topbar">
        <div class="topbar-brand">
            <div class="topbar-title-group">
                <div class="topbar-logo">LPU</div>
                <h2>Online Banking System</h2>
            </div>
            <div class="gold-accent-line"></div>
            <span class="subtitle-text">Administrator Control Panel • LPU-Laguna</span>
        </div>
        <a href="/logout" class="logout">Logout</a>
    </header>

    <main class="container">
        <div class="page-header">
            <div>
                <h1>Admin Portal</h1>
                <p>Manage customer accounts and records.</p>
            </div>
            <a href="/admin/create" class="btn primary">+ Create Customer Account</a>
        </div>

        <section class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                <h2>Customer Accounts</h2>
                <input type="text" id="searchInput" placeholder="Search by name or account..." onkeyup="filterTable()" style="max-width: 300px; padding: 0.5rem;">
            </div>

            <div class="table-container">
                <table id="customerTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer Name</th>
                            <th>Username</th>
                            <th>Account No.</th>
                            <th>Type</th>
                            <th>Balance</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% customers.forEach(customer => { %>
                            <tr>
                                <td><%= customer.customer_id %></td>
                                <td><strong><%= customer.first_name %> <%= customer.last_name %></strong></td>
                                <td><%= customer.username %></td>
                                <td><%= customer.account_number %></td>
                                <td><%= customer.account_type %></td>
                                <td class="money">₱<%= Number(customer.balance).toLocaleString('en-PH', {minimumFractionDigits: 2}) %></td>
                                <td><span class="status"><%= customer.status %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script>
        function filterTable() {
            const input = document.getElementById("searchInput").value.toLowerCase();
            const rows = document.querySelectorAll("#customerTable tbody tr");
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? "" : "none";
            });
        }
    </script>
</body>
</html>